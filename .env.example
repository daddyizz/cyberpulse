# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: YouTube Data API v3 key for searching songs and videos.
YOUTUBE_API_KEY=

# Spotify Web API credentials.
# IMPORTANT: Keep these server-side only. Do NOT prefix the client secret with VITE_.
# In Google AI Studio, add both values in the Secrets panel.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
