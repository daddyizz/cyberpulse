<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle cyber hexagonal badge outline -->
    <path
        android:pathData="M54,28 L76,40 L76,68 L54,80 L32,68 L32,40 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#338B5CFF" />

    <!-- Pulse Waveform Bars forming a forward-angled sonic crest / subtle play chevron -->
    <!-- Bar 1 (Leftmost, shorter) -->
    <path
        android:pathData="M38,47 L38,61"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeColor="#8B5CFF" />

    <!-- Bar 2 (Mid-left, taller) -->
    <path
        android:pathData="M44,40 L44,68"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeColor="#00F5FF" />

    <!-- Bar 3 (Apex pulse, tallest) -->
    <path
        android:pathData="M50,34 L50,74"
        android:strokeWidth="3.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="50"
                android:startY="34"
                android:endX="50"
                android:endY="74"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F5FF" />
                <item android:offset="0.5" android:color="#FF2ED1" />
                <item android:offset="1.0" android:color="#8B5CFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bar 4 (Mid-right, play node) -->
    <path
        android:pathData="M58,41 L58,67"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeColor="#00F5FF" />

    <!-- Bar 5 (Rightmost crest) -->
    <path
        android:pathData="M66,48 L66,60"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeColor="#8B5CFF" />

    <!-- Forward Play Chevron pointer -->
    <path
        android:pathData="M70,54 L75,54"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeColor="#00F5FF" />

    <!-- Subtle accent dots -->
    <path
        android:pathData="M54,22 A2,2 0 1,1 53.99,22 Z"
        android:fillColor="#00F5FF" />
    <path
        android:pathData="M54,86 A2,2 0 1,1 53.99,86 Z"
        android:fillColor="#8B5CFF" />
</vector>
